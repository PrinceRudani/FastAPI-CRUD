# Ignore Python compiled files
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
venv/
env/
.venv/

# Ignore IDE-specific files
.idea/
.vscode/
*.swp
*.swo

# Ignore log files
*.log
app.log
category.log

# Ignore database files
test.db

# Ignore configuration files (if sensitive)
config.ini
config.py

# Ignore Alembic migration files (if not needed in version control)
migrations/versions/
migrations/env.py

# Ignore pytest cache
.pytest_cache/

# Ignore macOS system files
.DS_Store

# Ignore Windows system files
Thumbs.db

# Ignore Python build artifacts
build/
dist/
*.egg-info/

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore local development files
.local/config.ini
