# Database Configuration
DB_SCHEME=mysql+pymysql
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=FastCRUD_db

# Token Settings
ACCESS_TOKEN=accesstoken
REFRESH_TOKEN=refreshtoken
ACCESS_TOKEN_EXP=5
REFRESH_TOKEN_EXP=24
TIME_OUT_MAX_AGE=100

# Security & Encryption
ENCODING=utf-8
HASH_ALGORITHM=HS256
JWT_SECRET_KEY=data

# User Roles
ROLE_ADMIN=admin
ROLE_USER=user
